# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-32-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Storage --------------------------------------------------------------
DATABASE_URL=sqlite:///./data/cvcoach.db
STORAGE_DIR=./data/storage
CHROMA_DIR=./data/chroma

# --- LLM provider ---------------------------------------------------------
# "stub"   = deterministic local provider, NO API key, NO network. Default.
# "openai" = real OpenAI calls; requires OPENAI_API_KEY below.
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=stub
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL_LARGE=gpt-4o
OPENAI_CHAT_MODEL_SMALL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=20

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
